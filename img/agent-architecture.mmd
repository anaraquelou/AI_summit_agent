graph TD
    START([START]) --> decide_path[decide_path]
    
    decide_path -->|sql_branch| list_tables[list_tables]
    decide_path -->|pdf_branch| pdf_branch[pdf_branch]
    decide_path -->|pdf_sql_branch| pdf_branch
    decide_path -->|general| answer[answer]
    
    pdf_branch -->|pdf_sql_branch| list_tables
    pdf_branch -->|pdf_branch| answer
    
    list_tables --> call_get_schema[call_get_schema]
    call_get_schema --> get_schema[get_schema]
    get_schema --> generate_query[generate_query]
    generate_query -->|has tool_calls| check_query[check_query]
    generate_query -->|no tool_calls| answer
    check_query --> run_query[run_query]
    run_query --> answer
    
    answer -->|process_order_return| process_return[process_return]
    answer -->|analyze_seller_reliability| analyze_seller_reliability[analyze_seller_reliability]
    answer -->|END| END([END])
    
    process_return --> answer
    analyze_seller_reliability --> answer
    
    style START fill:#90EE90
    style END fill:#FFB6C1
    style decide_path fill:#87CEEB
    style pdf_branch fill:#DDA0DD
    style answer fill:#F0E68C
    style process_return fill:#FFA07A
    style analyze_seller_reliability fill:#FFA07A
